--Question 7

--For the Trips that respectively started from Newark Airport, SoHo, and Yorkville East, in November 2019, 
--what are dropoff_zones with the 2nd longest p90 trip_duration ?

WITH data_trips as (

SELECT
*
FROM
local-proxy-450707-i1.dbt_jalhassan.fct_fhv_monthly_zone_traveltime_p90
WHERE 
pickup_zone IN ('Newark Airport', 'SoHo', 'Yorkville East') --filter required areas
AND MONTH = 11
),

ranking AS (
SELECT 
  year,
  month,
  dropoff_zone,
  trip_duration,
  p90_trip_duration,
  DENSE_RANK() OVER(PARTITION BY pickup_zone ORDER BY p90_trip_duration DESC) AS p90_trip_duration_rank,--RANK BY dropoff_zone
FROM data_trips
),

second_longest_trips as (

SELECT * FROM ranking 
WHERE 
p90_trip_duration_rank = 2 --2nd longest
)

SELECT 
DISTINCT(dropoff_zone),
p90_trip_duration

FROM second_longest_trips
ORDER BY p90_trip_duration DESC;