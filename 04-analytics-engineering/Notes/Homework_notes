Note: 
"days_back" >> command line arguments
"DAYS_BACK" >> ENV_VARS
"30" >> Default value
*/
SELECT *
FROM {{ ref('fact_trips') }}
WHERE clause to pickup_datetime >= CURRENT_DATE - INTERVAL '{{ var("days_back", env_var("DAYS_BACK", "30")) }}' DAY


